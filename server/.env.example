# ============================================================
# Thu Tech com — Environment Variables
# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` file to version control.
# ============================================================

# --- Server ---
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000

# --- PostgreSQL Database ---
# Use either DATABASE_URL (recommended for hosted/Supabase Postgres)
# or the individual PGHOST/PGUSER/etc. variables.
DATABASE_URL=postgres://thutechcom:changeme@localhost:5432/thutechcom
# PGHOST=localhost
# PGPORT=5432
# PGUSER=thutechcom
# PGPASSWORD=changeme
# PGDATABASE=thutechcom
PG_SSL=false

# --- Auth / Sessions ---
# Generate strong random values, e.g. `openssl rand -hex 32`
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
COOKIE_NAME=thutechcom_session
COOKIE_SECURE=false
# Set COOKIE_SECURE=true in production (requires HTTPS)

# --- Initial Super Admin (used by `npm run db:seed:admin`) ---
SEED_ADMIN_NAME=Site Administrator
SEED_ADMIN_EMAIL=admin@thutechcom.com
SEED_ADMIN_PASSWORD=ChangeMe123!

# --- CORS (only needed if the admin/public frontend is hosted on a different origin) ---
CORS_ORIGIN=http://localhost:4000

# --- File / Media Storage ---
# "local" stores uploads in /server/uploads and serves them at /uploads.
# Swap to "s3" later by implementing the same interface in src/utils/storage.js.
STORAGE_DRIVER=local
MAX_UPLOAD_SIZE_MB=8

# --- Email notifications (optional — used for new contact/support notifications) ---
# Leave blank to disable email sending; submissions are still saved to the database.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_EMAIL_TO=info@thutechcom.com
NOTIFY_EMAIL_FROM="Thu Tech com <no-reply@thutechcom.com>"

# --- Rate limiting ---
LOGIN_RATE_LIMIT_MAX=8
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
