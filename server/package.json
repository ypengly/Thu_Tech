{
  "name": "thutechcom-server",
  "version": "1.0.0",
  "description": "Thu Tech com — CMS backend (Express + PostgreSQL). Serves the REST API, the admin dashboard, and the public website.",
  "main": "src/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "db:migrate": "node src/db/migrate.js",
    "db:seed:admin": "node src/db/seed-admin.js",
    "db:seed:content": "node src/db/seed-migrate-content.js",
    "db:setup": "npm run db:migrate && npm run db:seed:admin && npm run db:seed:content",
    "db:export": "node src/db/export-content.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.11.5",
    "slugify": "^1.6.6",
    "zod": "^3.23.8"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
